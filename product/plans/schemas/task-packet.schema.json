{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vetryn.dev/schemas/planning/task-packet-v1.json",
  "title": "Vetryn executable task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "packetId",
    "task_id",
    "objective",
    "risk_class",
    "worker_type",
    "allowed_paths",
    "forbidden_paths",
    "scope_exclusions",
    "acceptance_checks",
    "validation_commands",
    "baseline_commands",
    "red_first_commands",
    "final_validation_commands",
    "required_worker_chain",
    "required_domain_review_chain",
    "lifecycle_gates",
    "evidence_required",
    "worker_evidence_required",
    "lifecycle_evidence_required",
    "lifecycle_evidence_refs",
    "packet_validation_command",
    "stop_conditions",
    "retry_budget",
    "runtime_pins",
    "alignment_gate_ref",
    "plan_drift_policy_ref",
    "factory_compatibility",
    "acceptance_ledger_ref",
    "acceptance_item_ids",
    "acceptance_result_requirements",
    "ci_lane_refs",
    "test_matrix_refs",
    "coverage_policy_refs",
    "security_scanner_gates",
    "engineering_policy_refs",
    "architecture_guidance_refs",
    "changelog_intent",
    "versioning_impact",
    "migration_impact",
    "docs_sync_refs",
    "source",
    "task",
    "currentState",
    "acceptanceItems",
    "gates",
    "requiredReviews",
    "execution"
  ],
  "properties": {
    "$schema": { "const": "https://vetryn.dev/schemas/planning/task-packet-v1.json" },
    "schemaVersion": { "const": "1.0.0" },
    "packetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+:(M0|V1)-[0-9]{2}:r[0-9]+$"
    },
    "task_id": { "$ref": "#/$defs/taskId" },
    "objective": { "$ref": "#/$defs/nonempty" },
    "risk_class": { "enum": ["low", "medium", "high"] },
    "worker_type": { "const": "task-executor" },
    "allowed_paths": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "forbidden_paths": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "scope_exclusions": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "acceptance_checks": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "validation_commands": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "baseline_commands": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "red_first_commands": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "final_validation_commands": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "required_worker_chain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "task-executor",
          "validation-gate",
          "code-review",
          "holdout-evaluator",
          "trace-grader",
          "evidence-attestor",
          "commit-push",
          "post-merge-monitor"
        ]
      },
      "contains": { "const": "task-executor" }
    },
    "required_domain_review_chain": {
      "type": "array",
      "uniqueItems": true,
      "items": { "const": "vetryn-trust-review" }
    },
    "lifecycle_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_validation_required",
        "ci_required",
        "code_review_required",
        "trust_review_required",
        "codex_review_required",
        "commit_push_required",
        "post_merge_monitor_required",
        "pr_lifecycle_report_required",
        "skip_policy"
      ],
      "properties": {
        "local_validation_required": { "type": "boolean" },
        "ci_required": { "type": "boolean" },
        "code_review_required": { "type": "boolean" },
        "trust_review_required": { "type": "boolean" },
        "codex_review_required": { "type": "boolean" },
        "commit_push_required": { "type": "boolean" },
        "post_merge_monitor_required": { "type": "boolean" },
        "pr_lifecycle_report_required": { "type": "boolean" },
        "skip_policy": { "const": "approved_exception_required" }
      }
    },
    "evidence_required": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "worker_evidence_required": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "lifecycle_evidence_required": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "lifecycle_evidence_refs": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "validation_report",
        "github_review_evidence",
        "ship_packet",
        "pr_lifecycle_report",
        "post_merge_report",
        "canonical_promotion"
      ],
      "properties": {
        "validation_report": { "$ref": "#/$defs/lifecycleArtifactRef" },
        "review_report": { "$ref": "#/$defs/lifecycleArtifactRef" },
        "trust_review_report": { "$ref": "#/$defs/lifecycleArtifactRef" },
        "github_review_evidence": { "$ref": "#/$defs/lifecycleArtifactRef" },
        "ship_packet": { "$ref": "#/$defs/lifecycleArtifactRef" },
        "pr_lifecycle_report": { "$ref": "#/$defs/lifecycleArtifactRef" },
        "post_merge_report": { "$ref": "#/$defs/lifecycleArtifactRef" },
        "canonical_promotion": { "$ref": "#/$defs/lifecycleArtifactRef" }
      },
      "additionalProperties": false
    },
    "packet_validation_command": { "const": "node scripts/task.mjs validate" },
    "stop_conditions": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "retry_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "current_attempt", "remaining_attempts"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "current_attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
        "remaining_attempts": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "runtime_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "toolchain_version",
        "module_or_package_path",
        "dependency_policy",
        "distribution_target",
        "provider_policy",
        "artifact_namespace",
        "live_work_policy"
      ],
      "properties": {
        "language": { "$ref": "#/$defs/nonempty" },
        "toolchain_version": { "$ref": "#/$defs/nonempty" },
        "module_or_package_path": { "$ref": "#/$defs/nonempty" },
        "dependency_policy": { "$ref": "#/$defs/nonempty" },
        "distribution_target": { "$ref": "#/$defs/nonempty" },
        "provider_policy": { "$ref": "#/$defs/nonempty" },
        "artifact_namespace": { "$ref": "#/$defs/nonempty" },
        "live_work_policy": { "$ref": "#/$defs/nonempty" }
      }
    },
    "alignment_gate_ref": { "$ref": "#/$defs/repoRef" },
    "plan_drift_policy_ref": { "$ref": "#/$defs/repoRef" },
    "factory_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory_contract_version",
        "profile_ref",
        "skill_vocabulary_version",
        "skill_inventory_ref",
        "generated_by",
        "deprecated_worker_policy",
        "deprecated_worker_aliases"
      ],
      "properties": {
        "factory_contract_version": { "const": "1.0" },
        "profile_ref": { "$ref": "#/$defs/repoPath" },
        "skill_vocabulary_version": { "const": "2026-06-09" },
        "skill_inventory_ref": { "$ref": "#/$defs/repoRef" },
        "generated_by": { "const": "vetryn-task-compiler" },
        "deprecated_worker_policy": { "const": "block_active_aliases" },
        "deprecated_worker_aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deprecated", "replacement", "status", "migration_behavior"],
            "properties": {
              "deprecated": { "const": "ship-pr" },
              "replacement": { "const": "commit-push" },
              "status": { "const": "deprecated" },
              "migration_behavior": { "$ref": "#/$defs/nonempty" }
            }
          }
        }
      }
    },
    "acceptance_ledger_ref": { "$ref": "#/$defs/repoPath" },
    "acceptance_item_ids": { "$ref": "#/$defs/nonemptyUniqueStrings" },
    "acceptance_result_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acceptance_item_id",
          "allowed_statuses",
          "evidence_mode",
          "closure_evidence",
          "evidence_required",
          "worker_evidence_required",
          "lifecycle_evidence_required"
        ],
        "properties": {
          "acceptance_item_id": { "$ref": "#/$defs/nonempty" },
          "allowed_statuses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["implemented", "partial", "missing", "blocked"] }
          },
          "evidence_mode": { "enum": ["automated", "manual_review"] },
          "closure_evidence": { "enum": ["validation_ref", "acceptance_evidence_record"] },
          "evidence_required": { "$ref": "#/$defs/nonemptyUniqueStrings" },
          "worker_evidence_required": { "$ref": "#/$defs/nonemptyUniqueStrings" },
          "lifecycle_evidence_required": { "$ref": "#/$defs/nonemptyUniqueStrings" }
        }
      }
    },
    "ci_lane_refs": { "$ref": "#/$defs/policyRefs" },
    "test_matrix_refs": { "$ref": "#/$defs/policyRefs" },
    "coverage_policy_refs": { "$ref": "#/$defs/policyGateRef" },
    "security_scanner_gates": { "$ref": "#/$defs/policyGateRef" },
    "engineering_policy_refs": { "$ref": "#/$defs/policyRefs" },
    "architecture_guidance_refs": { "$ref": "#/$defs/policyRefs" },
    "changelog_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "section", "draft_entry", "semver_marker"],
      "properties": {
        "impact": { "enum": ["required", "not_required"] },
        "section": { "$ref": "#/$defs/nonempty" },
        "draft_entry": { "$ref": "#/$defs/nonempty" },
        "semver_marker": { "$ref": "#/$defs/nonempty" }
      }
    },
    "versioning_impact": { "$ref": "#/$defs/nonempty" },
    "migration_impact": { "$ref": "#/$defs/nonempty" },
    "docs_sync_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/repoPath" },
          "reason": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baselineCommit",
        "productContract",
        "productContractDigest",
        "planPath",
        "ledgerPath",
        "statePath",
        "digests"
      ],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "baselineCommit": { "$ref": "#/$defs/sha" },
        "productContract": { "$ref": "#/$defs/repoPath" },
        "productContractDigest": { "$ref": "#/$defs/digest" },
        "planPath": { "$ref": "#/$defs/repoPath" },
        "ledgerPath": { "$ref": "#/$defs/repoPath" },
        "statePath": { "$ref": "#/$defs/repoPath" },
        "digests": {
          "type": "object",
          "minProperties": 5,
          "additionalProperties": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "risk",
        "dependsOn",
        "scope",
        "semanticInvariants",
        "deliverables",
        "requiredTestLevels",
        "capabilities",
        "stopConditions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "title": { "$ref": "#/$defs/nonempty" },
        "objective": { "$ref": "#/$defs/nonempty" },
        "risk": { "type": "object" },
        "dependsOn": { "type": "array", "items": { "type": "object" } },
        "scope": { "type": "object" },
        "semanticInvariants": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "deliverables": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "requiredTestLevels": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "capabilities": { "type": "object" },
        "stopConditions": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } }
      }
    },
    "currentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "attempt", "maxAttempts", "candidate"],
      "properties": {
        "state": {
          "enum": [
            "planned",
            "ready",
            "in_progress",
            "verification_pending",
            "review_pending",
            "changes_requested"
          ]
        },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "candidate": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseCommit", "commit", "executor"],
              "properties": {
                "baseCommit": { "$ref": "#/$defs/sha" },
                "commit": { "$ref": "#/$defs/sha" },
                "executor": { "$ref": "#/$defs/nonempty" }
              }
            }
          ]
        }
      }
    },
    "acceptanceItems": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "gates": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "requiredReviews": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementSkill",
        "verifySkill",
        "promoteSkill",
        "factorySkills",
        "executorMayAccept",
        "verifierMustDifferFromExecutor",
        "maintainerApprovalRequired",
        "progressIsGenerated",
        "deliveryPermissions"
      ],
      "properties": {
        "implementSkill": { "const": "vetryn-implement-task" },
        "verifySkill": { "const": "vetryn-verify-task" },
        "promoteSkill": { "const": "vetryn-promote-task" },
        "factorySkills": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["task-executor", "validation-gate", "code-review", "commit-push"]
          }
        },
        "executorMayAccept": { "const": false },
        "verifierMustDifferFromExecutor": { "type": "boolean" },
        "maintainerApprovalRequired": { "const": true },
        "progressIsGenerated": { "const": true },
        "deliveryPermissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowsProviderAccess", "mode", "requiresExplicitMaintainerAuthorization"],
          "properties": {
            "allowsProviderAccess": { "const": false },
            "mode": { "const": "factory-lifecycle-only" },
            "requiresExplicitMaintainerAuthorization": { "const": true }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "risk_class": { "const": "high" } },
        "required": ["risk_class"]
      },
      "then": {
        "properties": {
          "required_worker_chain": {
            "const": ["task-executor", "validation-gate", "code-review", "commit-push"]
          },
          "lifecycle_gates": {
            "type": "object",
            "properties": { "code_review_required": { "const": true } },
            "required": ["code_review_required"]
          },
          "lifecycle_evidence_required": {
            "type": "array",
            "contains": { "const": "review_report" }
          },
          "lifecycle_evidence_refs": {
            "type": "object",
            "properties": { "review_report": {} },
            "required": ["review_report"]
          },
          "execution": {
            "type": "object",
            "properties": {
              "factorySkills": {
                "const": ["task-executor", "validation-gate", "code-review", "commit-push"]
              }
            },
            "required": ["factorySkills"]
          }
        }
      },
      "else": {
        "properties": {
          "required_worker_chain": {
            "const": ["task-executor", "validation-gate", "commit-push"]
          },
          "lifecycle_gates": {
            "type": "object",
            "properties": { "code_review_required": { "const": false } },
            "required": ["code_review_required"]
          },
          "lifecycle_evidence_required": {
            "type": "array",
            "not": { "contains": { "const": "review_report" } }
          },
          "lifecycle_evidence_refs": {
            "type": "object",
            "propertyNames": { "not": { "const": "review_report" } }
          },
          "execution": {
            "type": "object",
            "properties": {
              "factorySkills": {
                "const": ["task-executor", "validation-gate", "commit-push"]
              }
            },
            "required": ["factorySkills"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gates": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "id": { "const": "QG-TRUST-REVIEW" } },
              "required": ["id"]
            }
          }
        },
        "required": ["gates"]
      },
      "then": {
        "properties": {
          "required_domain_review_chain": { "const": ["vetryn-trust-review"] },
          "lifecycle_gates": {
            "type": "object",
            "properties": { "trust_review_required": { "const": true } },
            "required": ["trust_review_required"]
          },
          "lifecycle_evidence_required": {
            "type": "array",
            "contains": { "const": "trust_review_report" }
          },
          "lifecycle_evidence_refs": {
            "type": "object",
            "properties": { "trust_review_report": {} },
            "required": ["trust_review_report"]
          }
        }
      },
      "else": {
        "properties": {
          "required_domain_review_chain": { "const": [] },
          "lifecycle_gates": {
            "type": "object",
            "properties": { "trust_review_required": { "const": false } },
            "required": ["trust_review_required"]
          },
          "lifecycle_evidence_required": {
            "type": "array",
            "not": { "contains": { "const": "trust_review_report" } }
          },
          "lifecycle_evidence_refs": {
            "type": "object",
            "propertyNames": { "not": { "const": "trust_review_report" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "taskId": { "type": "string", "pattern": "^(M0|V1)-[0-9]{2}$" },
    "repoPath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "repoRef": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "lifecycleArtifactRef": {
      "type": "string",
      "pattern": "^product/plans/oss-v1/evidence/lifecycle/(M0|V1)-[0-9]{2}/(?:unbound|[0-9a-f]{40})/[a-z_]+\\.json$"
    },
    "nonempty": { "type": "string", "minLength": 1 },
    "nonemptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "policyRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "rule"],
        "properties": {
          "source_ref": { "$ref": "#/$defs/repoRef" },
          "rule": { "$ref": "#/$defs/nonempty" },
          "command_refs": { "$ref": "#/$defs/nonemptyUniqueStrings" }
        }
      }
    },
    "policyGateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "source_ref", "policy"],
      "properties": {
        "required": { "type": "boolean" },
        "source_ref": { "$ref": "#/$defs/repoRef" },
        "policy": { "$ref": "#/$defs/nonempty" },
        "command_refs": { "$ref": "#/$defs/nonemptyUniqueStrings" }
      }
    }
  }
}
