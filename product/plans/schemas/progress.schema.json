{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vetryn.dev/schemas/planning/progress-v1.json",
  "title": "Generated Vetryn plan progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "planId",
    "taskCounts",
    "acceptanceCounts",
    "nextLegalTasks",
    "blockedTasks",
    "tasks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "planId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "taskCounts": { "$ref": "#/$defs/countMap" },
    "acceptanceCounts": { "$ref": "#/$defs/countMap" },
    "nextLegalTasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(M0|V1)-[0-9]{2}$" },
      "uniqueItems": true
    },
    "blockedTasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(M0|V1)-[0-9]{2}$" },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "state", "acceptedCriteria", "totalCriteria"],
        "properties": {
          "taskId": { "type": "string", "pattern": "^(M0|V1)-[0-9]{2}$" },
          "state": { "type": "string", "minLength": 1 },
          "acceptedCriteria": { "type": "integer", "minimum": 0 },
          "totalCriteria": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  }
}
