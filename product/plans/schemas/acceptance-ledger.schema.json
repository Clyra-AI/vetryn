{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vetryn.dev/schemas/planning/acceptance-ledger-v1.json",
  "title": "Vetryn acceptance ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "planId", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "planId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "taskId",
          "statement",
          "verification",
          "waivable",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "taskId": { "type": "string", "pattern": "^(M0|V1)-[0-9]{2}$" },
          "statement": { "type": "string", "minLength": 1 },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method"],
            "properties": {
              "method": { "enum": ["command", "test", "inspection", "review", "field"] },
              "testLevel": {
                "enum": ["static", "unit", "contract", "integration", "e2e", "adversarial", "field"]
              },
              "gateId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" }
            }
          },
          "waivable": { "type": "boolean" },
          "status": {
            "enum": [
              "planned",
              "verification_pending",
              "accepted",
              "blocked",
              "deferred_with_approval",
              "not_applicable"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
