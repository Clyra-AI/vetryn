{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vetryn.dev/schemas/planning/evidence-v1.json",
  "title": "Vetryn implementation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "taskId",
    "type",
    "actor",
    "commit",
    "createdAt",
    "result",
    "inputs",
    "gateBinding",
    "review",
    "redaction"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "taskId": { "type": "string", "pattern": "^(M0|V1)-[0-9]{2}$" },
    "type": {
      "enum": ["baseline-verification", "command-run", "github-checks", "review", "field"]
    },
    "actor": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["pass", "fail", "blocked"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "fail", "blocked"] },
              "url": { "type": "string", "format": "uri" },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planDigest", "lockfileDigest"],
      "properties": {
        "planDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "lockfileDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "gateBinding": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["gateId", "kind", "command"],
          "properties": {
            "gateId": { "type": "string", "pattern": "^QG-[A-Z0-9-]+$" },
            "kind": { "const": "command" },
            "command": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "review": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pullRequestReview" },
        { "$ref": "#/$defs/bootstrapOwnerComment" }
      ]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "containsRawModelOutput", "containsSecrets"],
      "properties": {
        "status": { "enum": ["verified", "not_applicable"] },
        "containsRawModelOutput": { "type": "boolean" },
        "containsSecrets": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "review" } }, "required": ["type"] },
      "then": { "properties": { "review": { "type": "object" } } },
      "else": { "properties": { "review": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "type": { "enum": ["command-run", "github-checks"] } },
        "required": ["type"]
      },
      "then": { "properties": { "gateBinding": { "type": "object" } } },
      "else": { "properties": { "gateBinding": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "type": { "const": "baseline-verification" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": { "planDigest": { "type": "null" } }
          }
        }
      },
      "else": {
        "properties": {
          "inputs": {
            "type": "object",
            "properties": { "planDigest": { "type": "string" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "pullRequestReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "subjectActor",
        "source",
        "state",
        "authorAssociation",
        "reviewId",
        "observedCommit",
        "authorizationRef"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "subjectActor": { "type": "string", "minLength": 1 },
        "source": { "const": "github-pull-request-review" },
        "state": { "const": "APPROVED" },
        "authorAssociation": { "enum": ["OWNER", "MEMBER", "COLLABORATOR"] },
        "reviewId": { "type": "integer", "minimum": 1 },
        "observedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "authorizationRef": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Clyra-AI/vetryn/pull/[0-9]+#pullrequestreview-[0-9]+$"
        }
      }
    },
    "bootstrapOwnerComment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "subjectActor",
        "source",
        "state",
        "authorAssociation",
        "commentId",
        "observedCommit",
        "authorizationBody",
        "authorizationRef"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "subjectActor": { "type": "string", "minLength": 1 },
        "source": { "const": "github-bootstrap-owner-comment" },
        "state": { "const": "APPROVED" },
        "authorAssociation": { "enum": ["OWNER", "MEMBER"] },
        "commentId": { "type": "integer", "minimum": 1 },
        "observedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "authorizationBody": {
          "type": "string",
          "pattern": "^<!-- vetryn-bootstrap-review:v1 -->\\nrepository=Clyra-AI/vetryn\\npull_request=[0-9]+\\ntask_id=(M0|V1)-[0-9]{2}\\ncandidate_sha=[0-9a-f]{40}\\ndecision=APPROVED\\nroles=[a-z][a-z0-9-]*(,[a-z][a-z0-9-]*)*$"
        },
        "authorizationRef": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/Clyra-AI/vetryn/pull/[0-9]+#issuecomment-[0-9]+$"
        }
      }
    }
  }
}
