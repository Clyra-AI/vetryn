{
  "name": "@vetryn/core",
  "version": "0.0.0",
  "description": "Versioned domain schemas and policy primitives for Vetryn.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clyra-AI/vetryn.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "clean": "rm -rf dist",
    "pack:check": "pnpm pack --pack-destination ../../.artifacts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
