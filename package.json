{
  "name": "vetryn-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Dependabot for AI model dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2"
    }
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm plan:check && pnpm lint && pnpm lint:deadcode && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check",
    "clean": "pnpm --recursive clean && rm -rf .artifacts coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:deadcode": "knip",
    "pack:check": "pnpm --recursive --if-present pack:check",
    "plan:check": "node scripts/plan.mjs check",
    "plan:write": "node scripts/plan.mjs write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
